-- allium: 3
-- chase-derive.allium
--
-- The derive pass (Phases 0 to 2 of the Allium-influenced changes, and
-- the skeleton generator, 2026-10-25): facts chase reads from parsed
-- bodies, from the compiler's HIE files and from its build log, the
-- checks that hold hand-written annotations to them, and the skeleton
-- annotations built from them. Companion to chase.allium, which covers
-- everything else about chase. Merge into it once these have run on a
-- real project other than chase.
--
-- Probes D1 to D5 are test/Probe.hs (cabal test chase-probes).
--
-- Scope
--   Includes: the Haskell derive pass over the parsed tree, the run-wide
--             constructor map, derived transitions, abstract types,
--             constant candidates, the three topology checks and the
--             consumes check (Phase 0); HIE reading, resolved callers,
--             effectful external uses, unreferenced bindings and
--             constructor usage (Phase 1); the build log's warnings
--             attached to signatures (Phase 2); the %untested block; the
--             structured invariant fields and open questions; the
--             skeleton generator.
--   Excludes: the PureScript derive pass (Phase 4), chase-annotate's
--             prompt (grace/genAnnotations.ffg), the Unison path.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity ChaseRun {
    roots: List<String>
    derive_enabled: Boolean
    hie_dir: String?
    build_log: BuildLog?
    skeleton_target: AnnotationsFile?
    skeletons: Skeleton with run = this
    hie_modules: HieModule with run = this
}

external entity HieFile {
    path: String
    ghc_version: String
}

external entity BuildLog {
    path: String
    text: String
}

external entity AnnotationsFile {
    path: String
    modules: Set<String>
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value DerivedEdge {
    type_name: String
    from: String
    to: String
    witness: String
}

value AbstractType {
    name: String
    hidden: List<String>
    makers: List<String>
}

value Edge {
    from: String
    to: String
}

value TopologyAnnotation {
    name: String
    vertices: List<String>
    edges: List<Edge>
    terminal: List<String>
}

value SumType {
    module_name: String
    type_name: String
    constructors: List<String>
}

value Ref {
    module_name: String
    unit: String
    name: String
    kind: RefKind
}

value Binding {
    name: String
    line: Integer
    refs: List<Ref>
}

value GhcWarning {
    file: String
    line: Integer
    flag: String
    message: String
    function: String?
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum Language { haskell | purescript }

enum Thrower { throwError | throwIO | throwM | throw | throwE | left | fail | error | exitWith }

enum RefKind { value | build | match | type_ref }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Skeleton {
    run: ChaseRun
    module_name: String
    language: Language
    signatures: List<String>
    sum_types: List<SumType>
    topologies: List<TopologyAnnotation>
    derived: Derived with skeleton = this
    rendered: Boolean
}

entity Derived {
    skeleton: Skeleton
    clauses: Map<String, List<String>>
    fails: Map<String, List<String>>
    literals: Map<String, List<String>>
    const_candidates: Map<String, String>
    edges: List<DerivedEdge>
    abstract: List<AbstractType>
    callers: Map<String, List<String>>
}

entity ConstructorMap {
    run: ChaseRun
    entries: Map<String, Set<SumType>>
}

entity Warning {
    skeleton: Skeleton
    text: String
}

entity HieModule {
    run: ChaseRun
    file: HieFile
    module_name: String
    unit: String
    exports: List<String>
    constructors: List<SumType>
    bindings: List<Binding>
}

entity HieFacts {
    skeleton: Skeleton
    uses: Map<String, List<String>>
    unreferenced: List<String>
}

entity SkeletonEntry {
    skeleton: Skeleton
    invariants: Map<String, SkeletonInvariant>
    constants: List<String>
    topologies: List<TopologyAnnotation>
}

value SkeletonInvariant {
    intent: String
    requires: List<String>
    ensures: List<String>
    fails: List<String>
    effects: List<String>
    consumes: List<String>
}

entity ConstructorUsage {
    run: ChaseRun
    module_name: String
    type_name: String
    constructor: String
    builders: List<String>
    matchers: List<String>
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule BuildConstructorMap {
    when: AllFilesParsed(run)
    requires: run.derive_enabled
    ensures:
        let map = ConstructorMap.created(run: run)
        for s in run.skeletons:
            for t in s.sum_types:
                for c in t.constructors:
                    map.entries[c].add(t)

    @guidance
        -- Every file is parsed before any file is derived, so a type
        -- declared in one module and transitioned in another is covered.
        -- Each file is parsed once; the derive is a closure over the tree,
        -- applied after the map exists.
}

rule DeriveHaskellModule {
    when: skeleton: Skeleton.created
    requires: skeleton.language = haskell
    requires: skeleton.run.derive_enabled
    ensures:
        let d = Derived.created(skeleton: skeleton)
        for f in skeleton.signatures:
            d.clauses[f] = clause_lines(f)
            d.fails[f] = failure_names(f)
            d.literals[f] = body_literals(f)
        d.const_candidates = literal_bindings(skeleton)
        d.abstract = hidden_constructor_types(skeleton)

    @guidance
        -- clause_lines: one line per clause of f that has a constructor
        -- or literal pattern or a guard other than otherwise, written as
        -- "pats | guard, guard".
        -- failure_names: the constructors and string literals that are
        -- the argument of a Thrower in f's body, applied directly or
        -- through $.
        -- body_literals: the literals in f's body other than 0, 1 and "",
        -- capped at twelve with a count of the rest.
        -- literal_bindings: every zero-argument top-level binding with one
        -- unguarded clause whose body is a literal, possibly negated.
        -- hidden_constructor_types: every data declaration the export list
        -- names without all its constructors, with the exported functions
        -- whose result type names it.
}

rule DeriveEdges {
    when: derived: Derived.created
    let map = ConstructorMap{run: derived.skeleton.run}
    ensures:
        for site in clause_sites(derived.skeleton):
            for b in built_constructors(site):
                for t in map.entries[b]:
                    let matched = matched_constructors(site) where t in map.entries[this]
                    if matched.count = 0:
                        derived.edges.add(DerivedEdge(t, "*", b, site.witness))
                    else:
                        for a in matched:
                            derived.edges.add(DerivedEdge(t, a, b, site.witness))

    @guidance
        -- clause_sites: every top-level clause and every case alternative
        -- inside one. A site's witness is "Module.function" of the
        -- enclosing top-level binding.
        -- An edge is drawn only between constructors of one type. A site
        -- that builds a constructor without matching one of that type gets
        -- "*" on the left; initial states, parsers and decoders look like
        -- that.
}

rule AttachCallers {
    when: skeleton: Skeleton.created
    requires: skeleton.run.derive_enabled
    requires: skeleton.run.hie_modules.count = 0
    let index = caller_index(skeleton.run.roots)
    ensures:
        for n in skeleton.signatures:
            skeleton.derived.callers[n] = index[skeleton.module_name, n]

    @guidance
        -- The index resolves references through each file's imports, the
        -- same rule coverage uses (chase.allium ResolveReference), and
        -- leaves out the binding's own definition site. The scan is over
        -- the run's roots as given, not the .cabal hs-source-dirs that
        -- chase-annotate's callers use, so a run over one directory of
        -- several reports callers from that directory only.
}

rule ReadHieFiles {
    when: HieDirGiven(run)
    requires: exists run.hie_dir
    ensures:
        for f in hie_files_under(run.hie_dir):
            if f.ghc_version = chase_ghc_version:
                HieModule.created(run: run, file: f)
            else:
                Warning.created(text: "hie: file could not be read")
    ensures: two files for one module keep the first in path order

    @guidance
        -- The reader is built against the ghc package of the compiler that
        -- builds chase; the flake's compiler setting chooses the version.
        -- Every identifier in a HIE file is resolved to its defining
        -- module and unit, so a reference needs no import resolution. A
        -- binding's references are the Use occurrences inside its span; a
        -- constructor under a Pat node is a match, elsewhere a build.
        -- Instance method bodies have no module-scope binding and are not
        -- attributed to anything.
}

rule ResolvedCallers {
    when: hm: HieModule.created
    ensures:
        for s in hm.run.skeletons:
            for n in s.signatures:
                s.derived.callers[n] = bindings across hm.run.hie_modules
                    whose refs contain Ref(s.module_name, _, n, value)

    @guidance
        -- When any HIE module was read, this index replaces the one from
        -- AttachCallers for every skeleton of the run. Names are exact, so
        -- two modules defining the same name are told apart, and bindings
        -- produced by Template Haskell are included.
}

rule DeriveHieFacts {
    when: skeleton: Skeleton.created
    let hm = HieModule{run: skeleton.run, module_name: skeleton.module_name}
    requires: exists hm
    let project_units = skeleton.run.hie_modules -> unit
    ensures:
        let f = HieFacts.created(skeleton: skeleton)
        for b in hm.bindings:
            f.uses[b.name] = b.refs where kind = value and unit not in project_units
                             -> module_name + "." + name, capped at twelve
        f.unreferenced = hm.bindings where name not in hm.exports
                         and skeleton.derived.callers[name].count = 0 -> name
}

rule DeriveConstructorUsage {
    when: AllHieRead(run)
    requires: run.hie_modules.count >= 1
    ensures:
        for hm in run.hie_modules:
            for t in hm.constructors:
                for c in t.constructors:
                    let builders = bindings across run.hie_modules with a ref
                                   Ref(hm.module_name, _, c, build)
                    let matchers = bindings across run.hie_modules with a ref
                                   Ref(hm.module_name, _, c, match)
                    if builders.count = 0 or (matchers.count = 0 and t.constructors.count >= 2):
                        ConstructorUsage.created(run: run, module_name: hm.module_name,
                            type_name: t.type_name, constructor: c,
                            builders: builders, matchers: matchers)

    @guidance
        -- A constructor nothing builds is a state the program never
        -- enters (Allium: missing producer). A constructor of a sum type
        -- nothing matches is a state nothing observes. Single-constructor
        -- types are exempt from the match check, since records are read
        -- through field selectors.
}

rule RenderDerived {
    when: skeleton: Skeleton.rendered becomes true
    requires: exists skeleton.derived
    ensures:
        Rendered(skeleton: skeleton, derived: skeleton.derived)

    @guidance
        -- Under each signature, after the ! and > lines and before the ?
        -- line: ~ clause, ~ fails, ~ literals, then ~ called by or
        -- ~ no callers in scanned roots.
        -- %const_candidate lines follow %const, for candidates whose name
        -- has no %const annotation.
        -- %abstract lines precede the data declarations.
        -- In bundle mode one DERIVED TRANSITIONS block ends the bundle,
        -- listing every type that has edges; in per-file mode the same
        -- block is DERIVED.chase.
        -- The preamble explains the ~ sigil as a may-fact.
}

rule CheckTopologyWitnesses {
    when: skeleton: Skeleton.rendered becomes true
    requires: skeleton.run.derive_enabled
    for top in skeleton.topologies:
        let candidates = skeleton.run's sum types where top.vertices all in constructors
        requires: candidates.count >= 1
        let t = candidates.first
        let edges = DerivedEdges where type_name = t.type_name
        ensures:
            for e in top.edges:
                if not edges.any(d => d.to = e.to and (d.from = e.from or d.from = "*")):
                    Warning.created(skeleton: skeleton,
                        text: "edge has no witness: no clause matches from and builds to")
            for d in edges:
                if d.from != "*" and d.from != d.to
                        and d.from in top.vertices and d.to in top.vertices
                        and not top.edges.any(e => e.from = d.from and e.to = d.to):
                    Warning.created(skeleton: skeleton,
                        text: "witness builds to from from, an edge the topology does not declare")

    @guidance
        -- The two obligations an Allium transition graph carries, with
        -- clauses standing in for rules: every declared edge is witnessed,
        -- and a witnessed edge is declared. Both are warnings because the
        -- derived edges are may-edges read from syntax.
}

rule CheckTopologyUnmatched {
    when: skeleton: Skeleton.rendered becomes true
    requires: skeleton.run.derive_enabled
    for top in skeleton.topologies:
        requires: not exists sum type whose constructors contain all of top.vertices
        ensures:
            Warning.created(skeleton: skeleton,
                text: "vertices name no constructor set in the parsed sources; nothing to check against")
}

rule CheckTopologyExits {
    when: skeleton: Skeleton.rendered becomes true
    requires: skeleton.run.derive_enabled
    for top in skeleton.topologies:
        requires: top.terminal.count >= 1
        ensures:
            for v in top.vertices:
                if v not in top.terminal and not top.edges.any(e => e.from = v):
                    Warning.created(skeleton: skeleton,
                        text: "state is not listed as terminal and has no outbound edge")

    @guidance
        -- The third obligation of a transition graph. The terminal list is
        -- optional in the JSON; without it this check is skipped rather
        -- than guessed, since absence of outbound edges does not mean a
        -- state is terminal.
}

rule ReadBuildLog {
    when: BuildLogGiven(run)
    requires: exists run.build_log
    ensures:
        for block in warning_blocks(run.build_log.text):
            GhcWarning(block.file, block.line, block.flag, block.message, null)
    ensures: two warnings with the same file, line and flag are one
    ensures: error blocks and blocks with no source location are skipped

    @guidance
        -- A block starts with a line whose location ends in .hs or .purs
        -- followed by ": warning:", and runs through the indented lines
        -- after it. GHC 9.6 has no JSON diagnostics, so the text is the
        -- source. A module in several components is warned about once per
        -- component; hence the dedup. Warnings exist only for modules the
        -- compiler compiled, so the log must come from a full compile.
}

rule AttachWarnings {
    when: skeleton: Skeleton.created
    requires: exists skeleton.run.build_log
    ensures:
        for w in run warnings where w.file is a path suffix of
                skeleton.source.path or the reverse:
            w.function = the signature of skeleton with the greatest line
                         at or before w.line, or null when none precedes it
            skeleton.warnings.add(w)
    ensures: warnings matching no skeleton are counted and reported once

    @guidance
        -- The log's paths are relative to the package directory and the
        -- skeleton's to the run's roots, so the match is by suffix either
        -- way. A warning with function = null renders as a %ghc line at
        -- the top of the block; the others as ~ ghc lines under their
        -- signature. The compiler's pattern checker is what decides
        -- unhandled constructors and unreachable alternatives, which is
        -- what an Allium graph calls dead transitions and deadlocks.
}

rule WriteSkeleton {
    when: RunFinished(run)
    requires: exists run.skeleton_target
    for s in run.skeletons where s.module_name not in run.skeleton_target.modules:
        ensures:
            let e = SkeletonEntry.created(skeleton: s)
            for f in s.signatures:
                e.invariants[f] = SkeletonInvariant(
                    intent: "",
                    requires: s.derived.clauses[f],
                    ensures: [],
                    fails: s.derived.fails[f],
                    effects: s.hie_facts.uses[f],
                    consumes: s.derived.callers[f])
            e.constants = s.derived.const_candidates -> name
            e.topologies = for t in run derived topologies where
                t.module_name = s.module_name:
                    TopologyAnnotation(t.type_name, t.constructors,
                        edges of t where from != "*", terminal: [])
            run.skeleton_target.modules.add(s.module_name)
    ensures: modules already in run.skeleton_target are unchanged
    ensures: the file is written beside itself and renamed into place

    @guidance
        -- The deterministic half of Allium's distill. Everything the
        -- derive pass knows is filled in; intent, ensures, notes,
        -- decisions, open issues, open questions and the terminal lists
        -- are left for the author. Re-running adds only new modules.
}

rule CheckConsumesAgainstCallers {
    when: skeleton: Skeleton.rendered becomes true
    requires: exists skeleton.derived
    ensures:
        for i in skeleton.invariants:
            for c in i.consumes:
                let token = first_word(c)
                if is_qualified_function(token)
                        and token not in skeleton.derived.callers[i.function]:
                    Warning.created(skeleton: skeleton,
                        text: "consumes entry is not among the function's callers in the scanned roots")

    @guidance
        -- is_qualified_function: one or more capitalised module parts
        -- followed by a lower-case name, Server.Auth.loginHandler. consumes
        -- is wider than the call graph (a column read, a late subscriber),
        -- so entries that do not start that way are not checked.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant DerivedIsDeterministic {
    for s in Skeletons:
        derive(s) = derive(s)
}

invariant DerivedNeverRemovesHandWrittenLines {
    for s in Skeletons:
        hand_written_lines(render(s, with_derive)) = hand_written_lines(render(s, without_derive))
}

invariant EdgesStayWithinOneType {
    for e in DerivedEdges:
        e.from = "*" or (e.from in constructors_of(e.type_name) and e.to in constructors_of(e.type_name))
}

invariant HieFactsAreResolved {
    for f in HieFacts:
        for (b, names) in f.uses:
            names.all(n => n names a definition in a unit outside the run's HIE units)
}

invariant NoHieIsPhaseZero {
    for r in ChaseRuns:
        r.hie_modules.count = 0 implies bundle_bytes(r) = bundle_bytes_after_phase_0(r)
}

invariant SkeletonIsIdempotent {
    for r in ChaseRuns:
        exists r.skeleton_target implies
            write_skeleton(write_skeleton(r)) = write_skeleton(r)
}

invariant SkeletonRoundTrips {
    for e in SkeletonEntries:
        load(render_json(e)) = e
}

invariant DeriveOffIsTheOldOutput {
    for r in ChaseRuns:
        not r.derive_enabled implies bundle_bytes(r) = bundle_bytes_before_phase_0(r)
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred clause_lines(function)
deferred failure_names(function)
deferred body_literals(function)
deferred literal_bindings(skeleton)
deferred hidden_constructor_types(skeleton)
deferred clause_sites(skeleton)
deferred matched_constructors(site)
deferred built_constructors(site)
deferred caller_index(roots)
deferred first_word(text)
deferred is_qualified_function(token)
deferred hie_files_under(dir)
deferred chase_ghc_version
deferred warning_blocks(text)

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "A clause that matches constructor A and calls show B produces the edge A -> B. Should built constructors be limited to return positions, which is tractable syntactically but misses constructors passed to a state-setting function?"

open question "The caller index parses every source file a second time. Should the derive closure also expose the bindings and references so the index comes from the first parse?"

open question "Instance method bodies are not attributed to any binding, so a constructor used only inside an instance is reported as never built or never matched, and a function called only from an instance has no callers. Should instance methods become bindings named Class.Type.method?"

open question "A project of several packages writes one .inference/hie per package directory, and chase reads only the root one by default. Should the auto-detection walk the hs-source-dirs of every .cabal under the root, or should the cabal.project.local point every package at one directory?"

open question "An unfilled skeleton invariant (empty intent, derived lists only) renders nothing beyond what the ~ lines already say. Should the renderer skip invariants whose every field came from the derive pass, so the bundle does not carry the same fact twice?"

open question "PureScript has the same clause, failure and transition shapes in its CST. Is the Phase 0 pass worth porting before Phase 4 (CoreFn) exists, or does CoreFn make the syntactic pass redundant on that side?"
