cabal-version:      3.0
name:               chase
version:            0.1.0.0
synopsis:           Compress Haskell + PureScript source into LLM context skeletons
description:        Walks Haskell and PureScript source trees and emits a
                    structural skeleton (signatures, foreign imports, data
                    declarations, fixities, test coverage cross-refs) suitable
                    for feeding to LLMs as context.
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             Harry Pray
maintainer:         harry@prayivanil.org
copyright:          (c) 2025 Harry Pray
build-type:         Simple
extra-source-files:
  README.md
  chase-annotation.json
  grace/genAnnotations.ffg

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
  default-language: Haskell2010

-- ------------------------------------------------------------------
-- Vendored PureScript CST
-- ------------------------------------------------------------------

library vendor-purescript-cst
  import:           warnings
  hs-source-dirs:   vendor/purescript-cst
  default-extensions:
    BangPatterns
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveFunctor
    DeriveFoldable
    DeriveTraversable
    DeriveGeneric
    DerivingStrategies
    DerivingVia
    EmptyDataDecls
    FlexibleContexts
    FlexibleInstances
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    KindSignatures
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    PatternGuards
    PatternSynonyms
    RankNTypes
    RecordWildCards
    OverloadedRecordDot
    OverloadedStrings
    ScopedTypeVariables
    TupleSections
    TypeFamilies
    ViewPatterns
  exposed-modules:
    Chase.Vendor.PureScript.CST.Types
    Chase.Vendor.PureScript.CST.Lexer
    Chase.Vendor.PureScript.CST.Layout
    Chase.Vendor.PureScript.CST.Parser
    Chase.Vendor.PureScript.CST.Errors
    Chase.Vendor.PureScript.CST.Monad
    Chase.Vendor.PureScript.CST.Positions
    Chase.Vendor.PureScript.CST.Utils
    Chase.Vendor.PureScript.CST.Flatten
    Chase.Vendor.PureScript.Names
    Chase.Vendor.PureScript.PSString
    Chase.Vendor.PureScript.Roles
    Chase.Vendor.Control.Monad.Supply.Class
    Chase.Vendor.PureScript.AST.SourcePos
    Chase.Vendor.Control.Monad.Supply
    Chase.Vendor.PureScript.Comments
    Chase.Vendor.PureScript.CST.Print
    Chase.Vendor.PureScript.CST.Traversals
    Chase.Vendor.Data.Text.PureScript
    Chase.Vendor.PureScript.CST.Traversals.Type
  build-depends:
    , base                 >= 4.18    && < 5
    , aeson                >= 2.0
    , array
    , bytestring
    , containers
    , deepseq
    , dlist
    , hashable
    , mtl
    , parallel
    , scientific
    , text
    , transformers
    , utf8-string
    , serialise
    , vector
    , filepath
    , protolude
  build-tool-depends:
    happy:happy >= 1.20

-- ------------------------------------------------------------------
-- chase-annotations sublibrary
--
-- The shared data model (Chase.Types) plus the annotation JSON codec
-- (Chase.Annotations.Json). Deliberately thin: aeson/containers/text/
-- directory/bytestring only, no ghc-lib-parser, no grace, no network.
-- Both the deterministic chase core and the Unison client depend on it,
-- so the annotation format is defined in exactly one place.
-- ------------------------------------------------------------------

library chase-annotations
  import:           warnings
  visibility:       public
  hs-source-dirs:   src/annotations
  default-extensions:
    LambdaCase
    OverloadedStrings
    ScopedTypeVariables
  exposed-modules:
    Chase.Types
    Chase.Annotations.Json
  build-depends:
    , base                 >= 4.18    && < 5
    , aeson                >= 2.0
    , bytestring
    , containers
    , directory
    , text

-- ------------------------------------------------------------------
-- chase library proper (deterministic core, no network deps)
-- ------------------------------------------------------------------

library
  import:           warnings
  hs-source-dirs:   src/core
  default-extensions:
    LambdaCase
    OverloadedStrings
    ScopedTypeVariables
  exposed-modules:
    Chase
    Chase.Coverage
    Chase.Parse
    Chase.Parse.Haskell
    Chase.Parse.PureScript
    Chase.Pipeline
    Chase.Render
  reexported-modules:
    Chase.Types,
    Chase.Annotations.Json
  build-depends:
    , base                 >= 4.18    && < 5
    , aeson                >= 2.0
    , bytestring
    , chase:chase-annotations
    , containers
    , directory
    , filepath
    , ghc-lib-parser
    , syb
    , text
    , time
    , vendor-purescript-cst

-- ------------------------------------------------------------------
-- chase-codebase sublibrary (Unison local-API client)
--
-- Network client (http-client/http-types) plus the annotation-merge
-- and chase-format renderer for Unison codebases. Depends on the thin
-- chase-annotations lib for the shared model, but never on the parser
-- core or grace: still a small closure with no ghc-lib-parser.
-- ------------------------------------------------------------------

library chase-codebase
  import:           warnings
  visibility:       public
  hs-source-dirs:   src/codebase
  exposed-modules:
    Chase.Unison.Api
    Chase.Unison.Extract
    Chase.Unison.Annotate
  build-depends:
    , base                 >= 4.18    && < 5
    , aeson                >= 2.0
    , async
    , bytestring
    , chase:chase-annotations
    , containers
    , http-client
    , http-types
    , text

-- ------------------------------------------------------------------
-- chase-grace-bridge sublibrary
-- ------------------------------------------------------------------

library chase-grace-bridge
  import:           warnings
  visibility:       public
  hs-source-dirs:   src/bridge
  exposed-modules:
    Chase.GraceBridge
  build-depends:
    , base                 >= 4.18    && < 5
    , aeson                >= 2.0
    , chase
    , grace
    , text
    , http-client
    , http-types

-- ------------------------------------------------------------------
-- chase executable (deterministic core only)
-- ------------------------------------------------------------------

executable chase
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , chase
    , text
    , containers
    , directory
    , filepath
    , optparse-applicative

-- ------------------------------------------------------------------
-- chase-annotate executable (uses grace to populate annotations JSON)
-- ------------------------------------------------------------------

executable chase-annotate
  import:           warnings
  hs-source-dirs:   app-annotate
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , aeson                >= 2.0
    , bytestring
    , chase
    , chase:chase-grace-bridge
    , directory
    , filepath
    , grace
    , optparse-applicative
    , text

-- ------------------------------------------------------------------
-- chase-unison executable (Unison local-API probe + extractor)
-- ------------------------------------------------------------------

executable chase-unison
  import:           warnings
  hs-source-dirs:   app-unison
  main-is:          ChaseUnison.hs
  build-depends:
    , base
    , chase:chase-annotations
    , chase:chase-codebase
    , containers
    , text