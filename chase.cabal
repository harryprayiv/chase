cabal-version:   3.0
name:            chase
version:         0.1.0.0
synopsis:        Structural compression of Haskell and PureScript source for LLM context
description:
  Reads Haskell and PureScript source files and emits a compressed
  .chase representation suitable for LLM context. Combines automatic
  structural extraction (types, imports, data decls, foreign imports)
  with hand-curated invariants, decisions, open issues, and state
  machine topologies supplied via a sidecar annotations module.
author:          Harry Pray IV
license:         BSD-3-Clause
build-type:      Simple

common warnings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wmissing-export-lists
               -Wmissing-home-modules -Wpartial-fields
               -Wredundant-constraints

library
  import:             warnings
  hs-source-dirs:     src
  default-language:   GHC2021
  default-extensions: OverloadedStrings
                    , LambdaCase
                    , RecordWildCards
                    , DeriveGeneric
                    , StrictData
                    , DerivingStrategies
                    , BlockArguments
  exposed-modules:    Chase
                    , Chase.Types
                    , Chase.Parse
                    , Chase.Parse.Haskell
                    , Chase.Parse.PureScript
                    , Chase.Render
                    , Chase.Pipeline
                    , Chase.Annotations.Json
                    , Chase.Coverage

  build-depends:      base                 >= 4.18  && < 5
                    , text                 >= 2.0   && < 3
                    , containers           >= 0.6
                    , directory            >= 1.3
                    , filepath             >= 1.4
                    , time                 >= 1.12
                    , aeson                >= 2.0
                    , bytestring
                    , ghc-lib-parser
                    , syb                  >=0.7

executable chase
  import:             warnings
  main-is:            Main.hs
  hs-source-dirs:     app
  default-language:   GHC2021
  default-extensions: OverloadedStrings
                    , RecordWildCards
                    , LambdaCase
  build-depends:      directory ^>=1.3.8.5
                    , base
                    , chase
                    , text
                    , containers
                    , ghc-lib-parser