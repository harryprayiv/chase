%file /home/bismuth/git/chase/src/Chase/Coverage.hs
%mod Chase.Coverage

%ext LambdaCase, OverloadedStrings, RecordWildCards

%uses qualified Data.Generics as SYB
%uses Data.Generics
%uses Data.List
%uses qualified Data.Map.Strict as Map
%uses Data.Map.Strict
%uses qualified Data.Text as T
%uses Data.Text
%uses System.FilePath
%uses GHC.Hs
%uses GHC.Hs.Decls
%uses GHC.Hs.Binds
%uses GHC.Hs.Expr
%uses GHC.Parser.Annotation
%uses GHC.Types.SrcLoc
%uses GHC.Types.Name.Reader
%uses GHC.Types.Name.Occurrence
%uses Chase.Types
%uses qualified Chase.Parse.Haskell as HSP
%uses qualified Chase.Parse.PureScript as PSP

data TestBinding = TestBinding
  { tbModule   :: Text
  , tbFunction :: Text
  , tbLine     :: Int
  , tbRefs     :: [Text]
  }
  deriving Show

type TestRefIndex = Map Text [TestRef]

parseTestFile :: FilePath -> IO (Either ParseFailure [TestBinding])
  ! intent: Read a single Haskell test file and extract its top-level FunBindings with their referenced variable names
  ! effects: IO
  ! delegates parsing to Chase.Parse.Haskell.parseHsModule (same parser used for source files; no separate test parser)
  ! ParseFailure is returned as Left; the pipeline prints a warning and skips the file
  ! module name comes from Chase.Parse.Haskell.moduleNameOf; '' for files without a module header
  > consumed by: Chase.Pipeline.buildTestIndexOrEmpty (called once per test file when cfgTestRoots is non-empty)

parseHaskellTestFile :: FilePath -> IO (Either ParseFailure [TestBinding])

parsePureScriptTestFile :: FilePath -> IO (Either ParseFailure [TestBinding])

scanTestFile :: Text -> HsModule GhcPs -> [TestBinding]
  ! pure: takes an already-parsed HsModule and returns one TestBinding per top-level FunBind
  ! PatBinds, ClsInstD, type/class/data decls all produce zero TestBindings; only FunBind matches
  ! the tbRefs field is deduplicated via Data.List.nub; a test binding that mentions foo five times produces one occurrence in tbRefs

fromDecl :: Text -> LHsDecl GhcPs -> [TestBinding]
  ! internal helper used by scanTestFile; pattern-matches on the LHsDecl and returns a singleton or empty list
  ! the line number comes from startLine on the declaration's SrcSpan, same convention as Chase.Parse.Haskell

buildTestIndex :: [TestBinding] -> TestRefIndex
  ! inverts a flat list of TestBindings into a Map from referenced name to list of TestRefs
  ! self-references (a binding referring to its own name, i.e. recursion) are filtered out before indexing; see decision SelfReferencesAreDropped
  ! within a single index entry, TestRefs are deduplicated by (trModule, trFunction) and sorted by trSrcLine
  ! duplicate refs from the same (module, function) are coalesced; the line of the FIRST occurrence wins after sorting
  > consumed by: Chase.Pipeline.buildTestIndexOrEmpty (single caller; the index is then handed to every attachCoverage call)

attachCoverage :: TestRefIndex -> ChaseFile -> ChaseFile
  ! intent: Populate chaseTestCoverage by looking up each signature, foreign import, and pattern name in the index
  ! iterates chaseSignatures, then chaseForeignImports, then chasePatterns; produces one entry per name in those lists
  ! the value for a name with no test refs is the empty list, NOT a missing key; this lets the renderer emit 'no test references' explicitly
  ! the result is always Just <list>, never Nothing; Nothing is the 'didn't run' state that only emptyChaseFile produces
  > consumed by: Chase.Pipeline.applyPasses (only caller; runs after attachAnnotations, only when cfgTestRoots is non-empty)

collectVarsIn :: Data a => a -> [Text]
  ! polymorphic in the input: any Data-derived AST node works (MatchGroup, GRHSs, HsExpr, anything reachable from a FunBind body)
  ! visits every subterm via SYB.everything; the HsVar query fires anywhere a variable reference appears in expression position
  ! constructor patterns, type-level references, and identifier-position references in pattern matches are NOT collected; only HsVar in expressions
  ! result is a flat [Text] of unqualified names; deduplication happens at the call site via nub

rdrNameToText :: RdrName -> Text
  ! duplicated from Chase.Parse.Haskell to avoid importing internal helpers across modules
  ! extracts occNameString via rdrNameOcc; produces the unqualified identifier text

startLine :: SrcSpan -> Int
  ! duplicated from Chase.Parse.Haskell for the same reason
  ! RealSrcSpan -> 1-indexed start line; UnhelpfulSpan -> 0

%decision StaticReferenceScanNotHPC
  what:    Coverage is computed by walking each test file's AST and collecting HsVar references, NOT by running tests under HPC instrumentation
  why:     HPC is the canonical Haskell coverage tool but requires actually running the test suite (cabal test --enable-coverage) and parsing .tix files. That couples chase to your build system, your test runner, and the cwd at the time of running. Static reference scanning is offline: just parse test source. No build system involvement, no execution required, runs in milliseconds. The honest tradeoff: a name reference is NOT proof of behavioral testing. A test that mentions foo could be using it as a type annotation, a side dependency, or even printing its source line in a diagnostic. The output is a smell test (zero references = almost certainly untested), not a guarantee. If you need true coverage, run HPC separately; chase is not a replacement for it. The intent of the ? line is to surface obvious gaps cheaply, not to certify coverage.
  affects: scanTestFile, buildTestIndex, collectVarsIn

%decision TopLevelFunBindOnly
  what:    Only top-level FunBindings are recorded as test bindings; PatBindings and nested let-bindings are not surfaced as tests
  why:     A test in Haskell is almost always 'testFooHandlesX = ...' (a FunBind). PatBindings like '(a, b) = setup' produce values, not test cases, and tying them to a test name is awkward (which of a or b is 'the test'?). Refs inside the RHS of a PatBind that ARE relevant get picked up indirectly: the PatBind's body is part of the module, and any FunBind whose body references those names will still produce TestRefs. The PatBind itself just isn't a 'test'. Nested let-bindings are deliberately ignored. Their refs are picked up by collectVarsIn walking the enclosing FunBind body, so we don't lose coverage signal, we just don't get a 'tested by: SomeModule.someNestedHelper' line.
  affects: fromDecl, scanTestFile

%decision SelfReferencesAreDropped
  what:    buildTestIndex filters out the case where a test binding references its own name (recursion)
  why:     Recursive helpers like 'go n = if n <= 0 then [] else n : go (n - 1)' would otherwise appear as 'go tested by: TestModule.go', which is uninformative noise. The filter is safe: a real production function with the same name as a test binding would still show up if any OTHER test binding references it. We only drop the self-loop.
  affects: buildTestIndex

%decision SYBTraversalForRobustness
  what:    collectVarsIn uses SYB's 'everything' combinator over the Data instance instead of hand-rolled HsExpr traversal
  why:     HsExpr has 30+ constructors (HsApp, HsLam, HsLet, HsCase, HsIf, HsDo, HsTuple, HsList, HsOpApp, SectionL, SectionR, HsRecordCon, ExprWithTySig, ...) and ghc-lib-parser adds new ones across minor versions. A hand-rolled recursive traversal must enumerate every constructor and call itself on every sub-expression, and miss any new constructor silently. SYB.everything walks any Data-derived structure generically: it visits every subterm and applies our HsVar query wherever it fires. New AST constructors are picked up automatically with no change here. The cost is one extra dependency (syb) and the small runtime overhead of generic dispatch. For chase's scale (parse hundreds of test files once) this is invisible.
  affects: collectVarsIn

%open_issue UnqualifiedNameMatching
  what:     Test refs are matched by unqualified name only; two source modules exporting the same function name will both receive the same test refs
  why:      collectVarsIn extracts occNameString from RdrName, dropping any qualifier. A test that calls 'Chase.Parse.parseSourceFile' and a test that calls 'Chase.Parse.Haskell.parseSourceFile' both produce a TestRef keyed by 'parseSourceFile'. When the chase output renders, both Chase.Parse.parseSourceFile and Chase.Parse.Haskell.parseSourceFile signatures get the SAME tested-by list. One is accurate, the other is a false positive. Fix: extract qualifiers from Qual RdrNames and match the qualifier prefix against the source module name during attachment. Requires plumbing the source module name through attachCoverage.
  blocking: accurate coverage attribution in projects with naming collisions across modules
  affects:  collectVarsIn, attachCoverage, buildTestIndex

%open_issue HigherOrderReferencesMissed
  what:     A test that exercises foo via a higher-order indirection or stored reference can produce false negatives; a test that exercises foo through a renamed alias can also miss
  why:      The HsVar walker catches anything that lexically appears in expression position with the target name. List-of-functions like '[foo, bar]' is fine; foo and bar appear as HsVar. Things genuinely missed: function references introduced by Template Haskell splices (the splice output is what we'd want to walk, but ghc-lib-parser doesn't run splices); refs hidden behind generic dispatch (Generic-deriving, instance method dispatch); refs that only appear at the type level (rare for tests); refs accessed exclusively through a record-selector field or a type class method where the underlying function name is never lexically present in the test. These are inherent limits of static analysis without name resolution. Documenting them is more honest than promising they don't exist.
  affects:  collectVarsIn


