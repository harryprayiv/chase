%file /home/bismuth/git/chase/src/Chase/Annotations/Json.hs
%mod Chase.Annotations.Json

%ext LambdaCase, OverloadedStrings, RecordWildCards

%uses qualified Data.Aeson as A
%uses qualified Data.Aeson.Key as Key
%uses qualified Data.Aeson.KeyMap as KM
%uses qualified Data.Aeson.Types as AT
%uses qualified Data.ByteString.Lazy as LBS
%uses qualified Data.Map.Strict as Map
%uses Data.Map.Strict
%uses qualified Data.Text as T
%uses Data.Text
%uses System.Directory
%uses Chase.Types

data SpecEntry = SpecEntry
  { seInput    :: Text
  , seExpected :: Text
  }

instance A.FromJSON SpecEntry where

loadAnnotations
  :: FilePath -> IO (Either String (Map Text ModuleAnnotations))
  ! intent: Read and parse a JSON annotations file, returning a path-prefixed error message on failure
  ! effects: IO
  ! missing file returns Left, NOT empty
  ! Aeson decode errors and parser errors are both surfaced as Left with the path prefixed (so error output is useful at the CLI)
  > consumed by: app/Main.hs loadAnnotationsOrDie (calls exitFailure on Left)

loadAnnotationsIfExists :: FilePath -> IO (Map Text ModuleAnnotations)
  ! intent: Best-effort load; missing or malformed file becomes empty Map, not an error
  ! effects: IO
  ! use this in library contexts where 'no annotations' is a valid runtime state
  ! swallows parse errors silently; if you want diagnostics, use loadAnnotations

parseRoot :: A.Value -> AT.Parser (Map Text ModuleAnnotations)
  ! version defaults to 1 if absent; any other version fails with 'unsupported annotations version: N'
  ! modules object is required; absent or wrong-typed produces an Aeson parse error

parseModulesMap :: A.Object -> AT.Parser (Map Text ModuleAnnotations)
  ! iterates the JSON object's KeyMap; preserves keys EXACTLY as written via Key.toText (case-sensitive, no normalization)
  ! the resulting Map Text ModuleAnnotations is keyed by the literal JSON string; lookup in Chase.Pipeline.attachAnnotations must match exactly or it no-ops silently

parseModule :: Text -> A.Value -> AT.Parser ModuleAnnotations
  ! all five annotation lists (constants, invariants, decisions, openIssues, topologies) are OPTIONAL
  ! an empty module entry produces a ModuleAnnotations with all-empty fields, which then attaches as a no-op in the pipeline

parseConstant :: A.Value -> AT.Parser Constant
  ! name and value are required; notes is optional

noteFromText :: Text -> Note
  ! the 'BUG: ' prefix MUST include the trailing space; 'BUG:foo' (no space) is treated as a plain Note, not a BugNote
  ! this is intentional: it disambiguates accidental colons in note text

parseInvariantsMap :: A.Object -> AT.Parser [Invariant]
  ! iterates the JSON object's KeyMap; key order is whatever Aeson decoded order is (typically insertion order in modern aeson)
  ! the renderer does not re-sort; invariants appear in JSON object order, attached to signatures in source order

parseInvariantValue :: Text -> A.Value -> AT.Parser Invariant
  ! Array: parsed as [Text], wrapped via the inv smart constructor (no consumes, no hint)
  ! Object: passed to parseObjectInvariant which assembles a structured Invariant
  ! anything else: parser error with the function name and the expected shapes

parseObjectInvariant :: Text -> A.Object -> AT.Parser Invariant
  ! ORDER of assembled invLines: intent line, effects line, notes (verbatim), spec entries (rendered)
  ! consumes is NOT in invLines; it goes into invConsumes and renders separately with the > sigil
  ! hint is NOT in invLines; it goes into invBodyHint and renders after both ! and > lines
  ! all six fields are optional; an empty object produces an Invariant with empty lns and consumes
  > consumed by: Chase.Render.renderSignaturesWithInvariants (the renderer is the only consumer that distinguishes the four output streams)

renderSpec :: SpecEntry -> Text
  ! renders one SpecEntry as 'spec: <input> => <expected>' on a single line
  ! no escaping; spec strings are written into invLines verbatim

parseDecision :: A.Value -> AT.Parser Decision
  ! name, what required; affects defaults to empty
  ! why accepts string OR array of strings
  ! array form is joined with a single space (NOT a separator like '; ' or '. ') so authors should include their own punctuation if they want sentence breaks

parseOpenIssue :: A.Value -> AT.Parser OpenIssue
  ! name, what required; blocking and affects both default to empty
  ! why accepts string OR array of strings, same semantics as parseDecision
  ! shape mirrors parseDecision exactly except for the additional blocking field

parseWhy :: String -> A.Value -> AT.Parser Text
  ! string -> returned as-is
  ! array -> joined with a single space
  ! anything else -> parser error with the context name (e.g. 'decision.why must be a string or array of strings')

parseTopology :: A.Value -> AT.Parser Topology
  ! name, vertices, transitions all required
  ! transitions is a JSON object: keys are 'from' vertex names, values are arrays of 'to' vertex names
  ! no validation that transition vertex names appear in the vertices list

%decision SilentVsLoudFileMissing
  what:    loadAnnotationsIfExists returns empty on missing/malformed files; loadAnnotations returns Left
  why:     The CLI uses loadAnnotations so that an explicit --annotations path with a typo fails loudly (you asked for it, you should know it failed). Library callers wanting 'use annotations if present, else don't bother' get loadAnnotationsIfExists. Mixing the two semantics into one function with a Bool flag was the obvious alternative; two functions with self-documenting names won.
  affects: loadAnnotations, loadAnnotationsIfExists

%decision InvariantValueIsSumOfArrayOrObject
  what:    JSON invariant values are EITHER a flat array of strings OR an object with structured fields
  why:     The flat-array form keeps trivial annotations terse: ['line 1', 'line 2'] is enough when there are no specs, no consumes, no intent worth distinguishing. The object form is for invariants with structure: intent, effects, notes, spec, consumes, hint. A single uniform schema (always object) would force visual noise on the common case. A single uniform schema (always array) would force string-encoding tricks for the structured case. Other JSON types (number, bool, null) are explicit parse errors with the function name in the message.
  affects: parseInvariantValue, parseObjectInvariant

%decision VersionFieldIsForwardCompatibility
  what:    Top-level 'version' field; only version 1 is currently accepted
  why:     Version-on-write costs nothing and makes any future breaking change a one-line check rather than a guess-the-shape exercise. Default value when absent is 1 (treats unversioned files as version 1) so existing files don't need to be touched.
  affects: parseRoot


