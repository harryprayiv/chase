%file /home/bismuth/git/chase/src/Chase/Parse.hs
%mod Chase.Parse

%uses qualified Data.Text as T
%uses Data.Text
%uses qualified Data.Text.IO as TIO
%uses Data.Maybe
%uses Language.Haskell.Exts
%uses Chase.Types

data ParseFailure = ParseFailure
  { pfPath :: FilePath
  , pfMsg  :: Text
  }


parseSourceFile :: FilePath -> IO (Either ParseFailure ChaseFile)
  ! intent: Parse one .hs file, return either a structural skeleton or a diagnostic
  ! effects: IO
  ! reads the file twice: once into Text for source-span slicing, once via parseFileWithMode internally
  ! ParseFailure is data, not an exception; the caller decides whether to skip or abort
  ! fixities = Just (baseFixities <> commonOperatorFixities); without this many infix-heavy files fail with 'ambiguous infix expression'
  > consumed by: Chase.Pipeline.runPerFile (skip-and-continue on failure)
  > consumed by: Chase.Pipeline.runBundled (records failure in preamble counter, emits %parse_error block)

commonOperatorFixities :: [Fixity]
  ! covers lens, microlens, profunctors, aeson, and servant operators
  ! the symptom of a missing entry is 'ambiguous infix expression' from haskell-src-exts on a specific file

extractStructure :: FilePath -> [Text] -> Module SrcSpanInfo -> ChaseFile
  ! only handles Module; XmlPage and XmlHybrid silently produce an empty ChaseFile

extractModuleName :: ModuleHead l -> Text

extractPragmas :: [ModulePragma SrcSpanInfo] -> [Text]

nameText :: Name l -> Text

extractImport :: ImportDecl SrcSpanInfo -> Text

extractSignatures :: [Text] -> Decl SrcSpanInfo -> [Signature]
  ! extracts top-level TypeSig declarations AND class method signatures (recursing through ClassDecl > ClsDecl > Decl)
  ! class methods are emitted with UNQUALIFIED names — same shape as top-level signatures — so two classes declaring a method with the same name produce duplicate sigName entries; the renderer attaches at most one invariant per name
  ! default-method ClsDefSig and other future sig-bearing class body variants would be added in extractClassMethodSig in one place
  > consumed by: Chase.Render.renderSignaturesWithInvariants (the renderer assumes one Signature per top-level OR class-method binding)

extractClassMethodSig :: [Text] -> ClassDecl SrcSpanInfo -> [Signature]
  ! pulls TypeSig out of a class body via ClsDecl unwrapping
  ! delegates back to extractSignatures so any sig-bearing case added there is automatically picked up here too

extractChaseDataDecl :: [Text] -> Decl SrcSpanInfo -> Maybe ChaseDataDecl
  ! covers DataDecl, GDataDecl, TypeDecl, ClassDecl, InstDecl, TypeFamDecl, DataFamDecl, ClosedTypeFamDecl
  ! DataDecl/GDataDecl/TypeDecl/TypeFamDecl/DataFamDecl/ClosedTypeFamDecl render their full source span verbatim (the body IS the signature)
  ! ClassDecl and InstDecl render only the HEAD line via sliceFirstLine; class bodies are method sigs (extracted separately by extractSignatures), instance bodies are method defs (deliberately dropped). Head-only also dodges a haskell-src-exts span quirk where a class/instance span can over-extend into the following top-level declaration
  ! InstDecl uses the head class name as the identifier (e.g. 'Show' for `instance Show Foo`)
  ! DerivingDecl (standalone deriving) is NOT covered

declHeadName :: DeclHead l -> Text

instRuleName :: InstRule SrcSpanInfo -> Text
  ! extracts the head class name from an InstRule for use as a printable identifier
  ! instances do not have a single name in the language sense; this returns something useful for drift-check messages and rendered output without being load-bearing

instHeadName :: InstHead SrcSpanInfo -> Text
  ! walks an InstHead, peeling IHParen and IHApp wrappers to find the head class name

qNameText :: QName l -> Text
  ! renders a QName as 'Mod.Name' (Qual), 'Name' (UnQual), or '<special>' (Special)
  ! Special covers tuple constructors, list constructor, etc.; if one shows up as an instance head class name (it shouldn't in well-formed code) the placeholder is visible rather than crashing

startLine :: SrcSpanInfo -> Int

sliceSourceSpan :: [Text] -> SrcSpanInfo -> Text
  ! 1-indexed line slicing using the SrcSpan from the parser
  ! trusts the span; no bounds checking against the file length
  ! if a span is malformed the result is a possibly-truncated string, never a crash, because take/drop on lists are total

sliceFirstLine :: [Text] -> SrcSpanInfo -> Text
  ! returns ONLY the starting line of a source span, no body
  ! used for ClassDecl and InstDecl where rendering the body is undesirable AND the haskell-src-exts span can over-extend past the actual end of the declaration
  ! without this, an instance's source span can absorb the next top-level signature into its rendered block

%decision ParserIsHaskellSrcExtsNotGHC
  what:    Use haskell-src-exts plus a manual fixity and extension list
  why:     haskell-src-exts is small, pure, and has a stable AST. ghc-lib-parser is the actual GHC frontend but pulls in hundreds of MB of transitive deps and a much larger AST. Trade-off: any GHC syntax newer than the haskell-src-exts release will fail to parse. The README documents the parse-failure escape hatch (skip the file, keep going). If parse failures exceed ~10% of files in a real codebase, the answer is to switch parsers, not to keep extending these lists.
  affects: parseSourceFile, commonOperatorFixities


